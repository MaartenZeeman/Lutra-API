    "/api/verspakketten": {
      "get": {
        "tags": [
          "Verspakketten"
        ],
        "summary": "Gets a page of verspakketten.",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "description": "The number of items to skip. Default: 0.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "take",
            "in": "query",
            "description": "The maximum number of items to return. Default: 50.",
