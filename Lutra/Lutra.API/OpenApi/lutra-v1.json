              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Optional case-insensitive search term matched against the verspakket name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortField",
            "in": "query",
            "description": "The field to sort by: Naam, PrijsInCenten, AverageCijferSmaak, or AverageCijferBereiden. Default: Naam.",
            "schema": {
              "default": 0,
              "$ref": "#/components/schemas/VerspakketSortField"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "description": "The sort direction: Ascending or Descending. Default: Ascending.",
            "schema": {
              "default": 0,
              "$ref": "#/components/schemas/SortDirection"
            }
          }
        ],
